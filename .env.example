# Local defaults; replace database credentials and site URL for deployment.
DATABASE_URL=postgresql://pundarnytt:pundarnytt_local@localhost:55432/pundarnytt
POSTGRES_PASSWORD=pundarnytt_local
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Required on Vercel (Production AND Preview). Server-only; never NEXT_PUBLIC_.
# Connect a public Vercel Blob store to the project to obtain this token.
BLOB_READ_WRITE_TOKEN=
# VERCEL=1 is supplied automatically by Vercel; leave unset locally.
